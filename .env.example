# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Server & Runtime Configuration (cPanel / Dedicated Node.js 22.x)
NODE_ENV="development"
PORT=3000

# MariaDB 11.x / MySQL Production Database Configuration
DB_HOST="127.0.0.1"
DB_PORT=3306
DB_NAME="cafenard_db"
DB_USER="cafenard_user"
DB_PASSWORD="your_strong_mariadb_password"
DB_DIALECT="relational" # "mariadb" for live MariaDB pool or "sqlite" / embedded for standalone preview

# Security & Authentication (JWT Secret for Admin / Staff tokens)
JWT_SECRET="generate_a_random_64_character_secret_key_here"
JWT_EXPIRES_IN="7d"

# Domain & Multi-Tenant URLs (Configurable without hardcoding)
PUBLIC_APP_URL="http://localhost:3000"
ADMIN_APP_URL="http://localhost:3000/admin"
API_BASE_URL="http://localhost:3000/api"

# Payment Gateway Configuration (Provider-based: sandbox | zarinpal | idpay | nextpay)
PAYMENT_PROVIDER="sandbox"
PAYMENT_MERCHANT_ID="00000000-0000-0000-0000-000000000000"
PAYMENT_API_KEY="sandbox_api_key"
PAYMENT_CALLBACK_URL="http://localhost:3000/api/payments/callback"

# SMS Notification Provider (Optional - kavenegar | ghasedak | farazsms)
SMS_PROVIDER="mock"
SMS_API_KEY=""
SMS_SENDER_NUMBER=""
